<div class="bookmark-page">
  <div class="bookmark-card">
    <p class="bookmark-eyebrow">Playlist</p>

    <h1>Add a song</h1>

    <p class="bookmark-subtitle">
      Choose a track to add to <strong><%= @list.title %></strong>.
    </p>

    <%= simple_form_for [@list, @bookmark] do |f| %>
      <%= f.association :version,
                        label: "Pick a track",
                        label_method: ->(version) { "#{version.song.title} — #{version.artist.name}" } %>

      <%= f.button :submit,
                   "Add to playlist",
                   class: "btn bookmark-submit w-100 mt-3" %>
    <% end %>

    <%= link_to "Back to playlist",
                list_path(@list),
                class: "bookmark-back" %>
  </div>
</div>
