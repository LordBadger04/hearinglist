<div class="list-show-page">
  <div class="list-show-header">
    <div>
      <p class="list-show-label">Playlist</p>
      <h1><%= @list.title %></h1>
    </div>

    <div class="list-show-actions">
      <%= link_to new_list_bookmark_path(@list),
                  class: "btn btn-success" do %>
        <i class="fa-solid fa-plus me-2"></i>
        Add a song
      <% end %>

      <%= link_to lists_path,
                  class: "btn btn-outline-dark" do %>
        <i class="fa-solid fa-arrow-left me-2"></i>
        Back to lists
      <% end %>

      <%= link_to list_path(@list),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Delete this list?"
                  },
                  class: "btn btn-dark" do %>
        <i class="fa-solid fa-trash me-2"></i>
        Delete
      <% end %>
    </div>
  </div>

  <% if @list.bookmarks.any? %>
  <div class="song-cards">
    <% @list.bookmarks.each do |bookmark| %>
      <% version = bookmark.version %>

      <div class="song-card">
        <div class="song-card-content">
          <p class="song-card-label"><%= version.style&.upcase %> VERSION</p>

          <h2>
            <%= link_to version.song.title,
                        version.version_url,
                        target: :blank,
                        rel: "noopener",
                        class: "stretched-link text-decoration-none text-dark" %>
          </h2>

          <p class="song-card-artist">
            <%= version.artist.name %>
          </p>

          <div class="song-card-details">
            <span><%= version.style %></span>

            <% if version.year.present? %>
              <span><%= version.year %></span>
            <% end %>
          </div>
        </div>

        <div class="song-card-actions">
          <div class="song-card-icon">♪</div>

            <%= link_to bookmark_path(bookmark),
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Remove this song from the playlist?"
                        },
                        class: "song-card-delete" do %>
              <i class="fa-solid fa-trash"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="list-show-empty">
    <h2>Your saved songs will appear here</h2>

    <p>
      Add songs and live covers to this playlist from HearingList.
    </p>
  </div>
<% end %>

</div>
<style>
  .song-card-link {
    display: block;
    text-text-decoration: none;
    color: inherit;
    width: 100%;
  }
</style>
