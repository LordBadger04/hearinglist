<nav class="navbar hearing-navbar sticky-top">
  <div class="container-fluid px-4">
    <h2 class="mb-0">
      <%= link_to "HearingList", root_path, class: "hearing-navbar-brand" %>
    </h2>

    <% if user_signed_in? %>
      <div class="d-flex align-items-center gap-2">
        <%= form_with url: chats_path, method: :post do %>
          <%= submit_tag "Start AI chat", class: "btn btn-dark" %>
        <% end %>

        <%= link_to "Log out",
                    destroy_user_session_path,
                    data: { turbo_method: :delete },
                    class: "btn btn-outline-dark" %>
      </div>
    <% end %>
  </div>
</nav>
